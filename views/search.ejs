<%- include('partials/header') %>

<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

  <!-- Search Header -->
  <div class="mb-8">
    <h1 class="text-2xl sm:text-3xl font-extrabold text-stone-900 tracking-tight mb-2">
      <% if (query) { %>
        Search Results for: <span class="text-emerald-700">"<%= query %>"</span>
      <% } else { %>
        Search PawPulse Clinical Guides
      <% } %>
    </h1>
    <p class="text-xs text-stone-500">
      <% if (query) { %>
        Found <%= results.length %> matching articles across 200+ indexed pet guides.
      <% } else { %>
        Search by species, condition, behavioral symptom, or grooming question.
      <% } %>
    </p>
  </div>

  <div class="flex flex-col lg:flex-row gap-10">

    <!-- Search Results List -->
    <div class="flex-1 min-w-0">

      <!-- Prominent Search Input -->
      <form action="<%= baseUrl %>/search" method="GET" class="mb-8">
        <div class="relative">
          <input 
            type="text" 
            name="q" 
            placeholder="Type your question (e.g. cat nail clipping, bearded dragon UVB, dog bloat)..." 
            value="<%= query %>" 
            class="w-full px-5 py-3.5 pl-12 rounded-2xl bg-white border border-stone-200 text-sm text-stone-900 shadow-xs focus:outline-none focus:ring-2 focus:ring-emerald-500"
            required
          />
          <div class="absolute left-4 top-1/2 -translate-y-1/2 text-stone-400">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
          </div>
          <button type="submit" class="absolute right-2.5 top-1/2 -translate-y-1/2 px-5 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs shadow-xs transition">
            Search
          </button>
        </div>
      </form>

      <% if (results && results.length > 0) { %>
        <div class="space-y-4">
          <% results.forEach(art => { %>
            <article class="p-5 rounded-2xl bg-white border border-stone-200/80 hover:border-emerald-500 transition shadow-xs flex flex-col sm:flex-row items-start gap-4 group">
              <div class="w-full sm:w-40 h-28 rounded-xl overflow-hidden bg-stone-100 shrink-0">
                <img src="<%= art.featured_image %>" alt="<%= art.title %>" class="w-full h-full object-cover group-hover:scale-105 transition duration-300" loading="lazy" />
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-1">
                  <span class="text-[10px] uppercase font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded">
                    <%= art.pet_type %>
                  </span>
                  <span class="text-[10px] text-stone-400">•</span>
                  <span class="text-[10px] text-stone-400"><%= formatDate(art.published_at) %></span>
                </div>
                <h3 class="text-base font-bold text-stone-900 leading-snug group-hover:text-emerald-600 transition mb-1.5">
                  <a href="<%= baseUrl %>/blog/<%= art.slug %>"><%= art.title %></a>
                </h3>
                <p class="text-xs text-stone-600 line-clamp-2 leading-relaxed mb-2">
                  <%= art.excerpt %>
                </p>
                <div class="flex items-center gap-3 text-[11px] text-stone-400">
                  <span>By <%= art.author_name %></span>
                  <span>•</span>
                  <span><%= art.reading_time_minutes %> min read</span>
                </div>
              </div>
            </article>
          <% }) %>
        </div>
      <% } else if (query) { %>
        <div class="p-12 text-center bg-white rounded-3xl border border-stone-200">
          <span class="text-4xl block mb-2">🔍</span>
          <h3 class="text-lg font-bold text-stone-800 mb-1">No guides matched "<%= query %>"</h3>
          <p class="text-xs text-stone-500 max-w-sm mx-auto mb-4">
            Try searching for broader terms like "cat", "dog", "python", "lizard", "diet", or "grooming".
          </p>
          <a href="<%= baseUrl %>/popular" class="inline-block px-4 py-2 bg-emerald-600 text-white rounded-xl text-xs font-bold">
            Explore Most Popular Guides &rarr;
          </a>
        </div>
      <% } %>

    </div>

    <!-- Right Sidebar -->
    <%- include('partials/sidebar') %>

  </div>

</main>

<%- include('partials/footer') %>
