<%- include('partials/header') %>

<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

  <!-- Header Banner -->
  <div class="mb-10 text-center max-w-3xl mx-auto space-y-3">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-rose-50 text-rose-700 border border-rose-200 text-xs font-bold uppercase tracking-wider">
      <span>🔥</span> Reader Hall of Fame
    </div>
    <h1 class="text-3xl sm:text-5xl font-extrabold text-stone-900 tracking-tight m-0">
      Most Popular Pet Guides
    </h1>
    <p class="text-sm sm:text-base text-stone-600 leading-relaxed">
      The most-read, bookmarked, and shared clinical care sheets, behavior breakdowns, and species manuals across our entire network.
    </p>
  </div>

  <div class="flex flex-col lg:flex-row gap-10">

    <!-- Popular Articles Grid (Numbered 1..24) -->
    <div class="flex-1 min-w-0 space-y-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <% popularArticles.forEach((art, idx) => { %>
          <article class="bg-white rounded-2xl border border-stone-200/80 overflow-hidden shadow-xs hover:shadow-md transition duration-300 flex flex-col group relative">
            
            <div class="relative h-48 overflow-hidden bg-stone-100">
              <img src="<%= art.featured_image %>" alt="<%= art.title %>" class="w-full h-full object-cover group-hover:scale-105 transition duration-500" loading="lazy" />
              
              <!-- Rank Badge -->
              <div class="absolute top-3 left-3 flex items-center gap-1.5">
                <span class="w-7 h-7 rounded-lg bg-emerald-600 text-white font-extrabold text-xs flex items-center justify-center shadow-md">
                  #<%= idx + 1 %>
                </span>
                <span class="px-2.5 py-1 rounded-lg bg-stone-900/80 backdrop-blur-xs text-white text-[10px] font-extrabold uppercase tracking-wider">
                  <%= art.pet_type %>
                </span>
              </div>

              <!-- Popular Reads Pill -->
              <div class="absolute bottom-3 right-3 px-2 py-0.5 rounded-md bg-stone-950/70 text-white text-[10px] font-bold">
                <%= art.views %> reads
              </div>
            </div>

            <div class="p-5 flex-1 flex flex-col justify-between">
              <div>
                <h3 class="text-base font-extrabold text-stone-900 leading-snug group-hover:text-emerald-600 transition mb-2">
                  <a href="<%= baseUrl %>/blog/<%= art.slug %>"><%= art.title %></a>
                </h3>
                <p class="text-xs text-stone-600 line-clamp-3 leading-relaxed mb-4">
                  <%= art.excerpt %>
                </p>
              </div>

              <div class="pt-4 border-t border-stone-100 flex items-center justify-between text-xs text-stone-400">
                <span class="text-stone-700 font-semibold"><%= art.author_name %></span>
                <span><%= art.reading_time_minutes %> min read</span>
              </div>
            </div>
          </article>
        <% }) %>
      </div>
    </div>

    <!-- Right Sidebar -->
    <%- include('partials/sidebar') %>

  </div>

</main>

<%- include('partials/footer') %>
