<%- include('partials/header') %>

<main class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
  <div class="bg-white rounded-3xl p-6 sm:p-12 border border-stone-200/80 shadow-xs space-y-8">
    
    <div>
      <span class="px-3 py-1 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-200 text-xs font-bold uppercase tracking-wider">
        Get in Touch
      </span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-stone-900 tracking-tight mt-3 mb-2">
        Contact the PawPulse Editorial Team
      </h1>
      <p class="text-sm text-stone-600">
        Have a question about a clinical guide, species protocol, advertising inquiry, or partnership proposal? We are here to help.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 pt-4">
      
      <!-- Contact Info -->
      <div class="space-y-6">
        <div class="p-6 rounded-2xl bg-stone-50 border border-stone-200 space-y-4">
          <h3 class="text-lg font-bold text-stone-900 flex items-center gap-2">
            <span>📫</span> Editorial & Press Inquiries
          </h3>
          <p class="text-xs text-stone-600 leading-relaxed">
            Our editorial desk is managed by veterinary clinicians and credentialed ethologists. Reach us directly for corrections, fact-checking reviews, or medical board inquiries.
          </p>
          <div class="pt-2 text-xs space-y-2">
            <p><strong class="text-stone-700">Editorial Email:</strong> <a href="mailto:<%= config.site.contactEmail %>" class="text-emerald-600 hover:underline"><%= config.site.contactEmail %></a></p>
            <p><strong class="text-stone-700">Publisher:</strong> <%= config.site.publisher %></p>
            <p><strong class="text-stone-700">Hours:</strong> Monday – Friday, 9:00 AM – 5:00 PM EST</p>
          </div>
        </div>

        <div class="p-6 rounded-2xl bg-emerald-50/60 border border-emerald-200 space-y-3">
          <h3 class="text-lg font-bold text-emerald-950 flex items-center gap-2">
            <span>📢</span> Advertising & Brand Partnerships
          </h3>
          <p class="text-xs text-emerald-900 leading-relaxed">
            For programmatic advertising inquiries, direct display sponsorship, or certified ethical affiliate collaborations, contact our media team:
          </p>
          <p class="text-xs">
            <strong class="text-emerald-950">Partnerships:</strong> <a href="mailto:partnerships@pawpulse.org" class="text-emerald-700 underline font-semibold">partnerships@pawpulse.org</a>
          </p>
        </div>
      </div>

      <!-- Contact Form -->
      <div class="p-6 rounded-2xl border border-stone-200 bg-white shadow-xs">
        <h3 class="text-lg font-bold text-stone-900 mb-4">Send a Direct Message</h3>
        <form onsubmit="event.preventDefault(); alert('Thank you for reaching out! Our editorial team reviews messages within 24-48 business hours.'); this.reset();" class="space-y-4 text-xs">
          <div>
            <label class="block font-bold text-stone-700 mb-1">Your Full Name</label>
            <input type="text" required placeholder="Dr. Jane Smith" class="w-full px-3.5 py-2.5 rounded-xl border border-stone-300 focus:outline-none focus:ring-2 focus:ring-emerald-500" />
          </div>
          <div>
            <label class="block font-bold text-stone-700 mb-1">Email Address</label>
            <input type="email" required placeholder="jane@example.com" class="w-full px-3.5 py-2.5 rounded-xl border border-stone-300 focus:outline-none focus:ring-2 focus:ring-emerald-500" />
          </div>
          <div>
            <label class="block font-bold text-stone-700 mb-1">Subject / Inquiry Type</label>
            <select class="w-full px-3.5 py-2.5 rounded-xl border border-stone-300 focus:outline-none focus:ring-2 focus:ring-emerald-500">
              <option>Clinical Guide Question or Feedback</option>
              <option>Advertising / AdSense Inquiry</option>
              <option>Affiliate & Sponsorship Request</option>
              <option>Media & Press Interview</option>
              <option>Other / General Feedback</option>
            </select>
          </div>
          <div>
            <label class="block font-bold text-stone-700 mb-1">Your Message</label>
            <textarea rows="4" required placeholder="Please describe your question or proposal..." class="w-full px-3.5 py-2.5 rounded-xl border border-stone-300 focus:outline-none focus:ring-2 focus:ring-emerald-500"></textarea>
          </div>
          <button type="submit" class="w-full py-3 px-4 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-xl transition shadow-sm">
            Submit Inquiry &rarr;
          </button>
        </form>
      </div>

    </div>

  </div>
</main>

<%- include('partials/footer') %>
