  <!-- 5. Footer -->
  <footer class="bg-stone-900 text-stone-300 pt-16 pb-28 border-t border-stone-800 mt-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 pb-12 border-b border-stone-800">
        
        <!-- Col 1: About PawPulse -->
        <div class="lg:col-span-2 space-y-4">
          <div class="flex items-center gap-2">
            <span class="text-2xl">🐾</span>
            <span class="text-xl font-extrabold text-white"><%= config.site.name %></span>
          </div>
          <p class="text-xs text-stone-400 leading-relaxed max-w-sm">
            PawPulse is a dedicated digital publication founded by veterinary clinicians and certified animal behaviorists. Our mission is to provide research-backed, compassionate guidance across every companion species—from canine psychology to exotic reptile environmental design.
          </p>
          <div class="flex items-center gap-3 text-xs text-stone-400 font-semibold pt-2">
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-stone-800 border border-stone-700 text-emerald-400">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
              200+ Authoritative Guides Live
            </span>
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-stone-800 border border-stone-700 text-amber-400">
              <span>⚡</span> 50 Daily Auto-Researched Posts
            </span>
          </div>
        </div>

        <!-- Col 2: Species Silos -->
        <div>
          <h4 class="text-xs font-bold uppercase tracking-wider text-white mb-4">Species Hubs</h4>
          <ul class="space-y-2 text-xs">
            <% categories.slice(0, 4).forEach(cat => { %>
              <li>
                <a href="/category/<%= cat.slug %>" class="hover:text-emerald-400 transition flex items-center gap-1.5">
                  <span><%= cat.icon %></span>
                  <span><%= cat.name %></span>
                </a>
              </li>
            <% }) %>
          </ul>
        </div>

        <!-- Col 3: Exotics & More -->
        <div>
          <h4 class="text-xs font-bold uppercase tracking-wider text-white mb-4">Exotics & Aquatics</h4>
          <ul class="space-y-2 text-xs">
            <% categories.slice(4).forEach(cat => { %>
              <li>
                <a href="/category/<%= cat.slug %>" class="hover:text-emerald-400 transition flex items-center gap-1.5">
                  <span><%= cat.icon %></span>
                  <span><%= cat.name %></span>
                </a>
              </li>
            <% }) %>
            <li>
              <a href="/popular" class="hover:text-emerald-400 transition flex items-center gap-1.5 font-bold text-amber-400">
                <span>🔥</span>
                <span>All Trending Articles</span>
              </a>
            </li>
          </ul>
        </div>

        <!-- Col 4: Authority & Automation -->
        <div>
          <h4 class="text-xs font-bold uppercase tracking-wider text-white mb-4">Authority & Platform</h4>
          <ul class="space-y-2 text-xs">
            <li><a href="/about" class="hover:text-emerald-400 transition">Editorial Guidelines</a></li>
            <li><a href="/about#veterinary-board" class="hover:text-emerald-400 transition">Veterinary Review Board</a></li>
            <li><a href="/admin/automation" class="text-emerald-400 hover:underline font-bold">Automation Control Room</a></li>
            <li><a href="/sitemap.xml" class="hover:text-emerald-400 transition">XML Sitemap (SEO)</a></li>
            <li><a href="/rss.xml" class="hover:text-emerald-400 transition">RSS 2.0 Feed</a></li>
            <li><a href="/robots.txt" class="hover:text-emerald-400 transition">Robots.txt Directives</a></li>
          </ul>
        </div>

      </div>

      <!-- Legal, FTC Affiliate Disclosure, and Copyright -->
      <div class="pt-8 text-xs text-stone-500 space-y-4">
        <p class="leading-relaxed">
          <strong class="text-stone-400">Veterinary Medical Disclaimer:</strong> The articles, videos, and guides on PawPulse are published for educational and informational purposes only and are not intended to substitute for clinical veterinary diagnosis, consultation, or individualized treatment. Always consult a licensed veterinarian regarding medical symptoms or emergencies.
        </p>
        <p class="leading-relaxed">
          <strong class="text-stone-400">FTC Affiliate & Advertising Disclosure:</strong> <%= config.monetization.affiliateDisclosure %>
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-between pt-4 border-t border-stone-800 text-[11px] gap-2">
          <span>&copy; <%= new Date().getFullYear() %> <%= config.site.name %>. All rights reserved. Powered by Science-Backed Pet Care.</span>
          <div class="flex items-center gap-4">
            <a href="/about" class="hover:underline">Privacy & Cookies</a>
            <a href="/about" class="hover:underline">Terms of Service</a>
            <a href="/admin/automation" class="text-emerald-400 font-bold hover:underline">Publishing Engine</a>
          </div>
        </div>
      </div>
    </div>
  </footer>

  <!-- Dismissible Mobile Sticky Bottom Ad Banner -->
  <div id="sticky-bottom-ad" class="fixed bottom-0 left-0 right-0 z-50 bg-stone-900 border-t border-stone-800 p-2 text-white shadow-2xl flex items-center justify-between sm:hidden">
    <div class="flex items-center gap-2 text-xs truncate mr-2">
      <span class="text-emerald-400 font-bold text-[10px] uppercase border border-emerald-400/40 px-1 py-0.5 rounded">Ad</span>
      <span class="truncate text-[11px]">Compare Top 5 Pet Insurance Providers (90% Vet Reimbursement)</span>
    </div>
    <div class="flex items-center gap-2 shrink-0">
      <a href="#sponsor-link" class="px-2.5 py-1 bg-emerald-500 text-stone-950 font-bold text-[10px] rounded">Check Rates</a>
      <button onclick="document.getElementById('sticky-bottom-ad').style.display='none'" class="text-stone-400 hover:text-white text-xs px-1">✕</button>
    </div>
  </div>

  <!-- AdSense & GDPR Compliant Cookie Consent Banner -->
  <div id="cookie-consent" class="fixed bottom-4 left-4 right-4 sm:left-auto sm:right-6 sm:max-w-md bg-stone-900 text-stone-200 border border-stone-800 p-4 rounded-2xl shadow-2xl z-50 text-xs hidden">
    <div class="flex items-start gap-3">
      <span class="text-xl">🍪</span>
      <div class="flex-1">
        <p class="leading-relaxed m-0 text-stone-300">
          We use cookies and third-party advertising partners (such as Google AdSense) to deliver relevant content, personalized ads, and analyze traffic.
        </p>
        <div class="flex items-center gap-2 mt-3">
          <button onclick="acceptCookies()" class="px-3 py-1.5 bg-emerald-500 hover:bg-emerald-400 text-stone-950 font-bold rounded-lg transition">Accept All</button>
          <a href="/about#affiliate" class="px-3 py-1.5 bg-stone-800 hover:bg-stone-700 text-stone-300 rounded-lg transition">Cookie Settings</a>
        </div>
      </div>
    </div>
  </div>

  <script>
    function checkCookieConsent() {
      if (!localStorage.getItem('pawpulse_cookies_accepted')) {
        document.getElementById('cookie-consent')?.classList.remove('hidden');
      }
    }
    function acceptCookies() {
      localStorage.setItem('pawpulse_cookies_accepted', 'true');
      document.getElementById('cookie-consent')?.classList.add('hidden');
    }
    window.addEventListener('DOMContentLoaded', checkCookieConsent);
  </script>

</body>
</html>
