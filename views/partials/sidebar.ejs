<!-- Persistent High-Converting Sidebar -->
<aside class="w-full lg:w-80 shrink-0 space-y-8">

  <!-- 1. MOST POPULAR POSTS (Core User Requirement) -->
  <div class="bg-white dark:bg-stone-900 rounded-2xl p-6 border border-stone-200/80 dark:border-stone-800 shadow-sm">
    <div class="flex items-center justify-between pb-4 mb-5 border-b border-stone-100 dark:border-stone-800">
      <div class="flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-rose-500 animate-pulse"></span>
        <h3 class="font-extrabold text-stone-900 dark:text-white text-base tracking-tight m-0">
          Most Popular Guides
        </h3>
      </div>
      <a href="/popular" class="text-xs font-bold text-emerald-600 dark:text-emerald-400 hover:underline">View All &rarr;</a>
    </div>

    <div class="space-y-4">
      <% if (typeof popularArticles !== 'undefined' && popularArticles && popularArticles.length) { %>
        <% popularArticles.slice(0, 6).forEach((pop, idx) => { %>
          <article class="flex items-start gap-3.5 group">
            <span class="w-6 h-6 rounded-lg bg-stone-100 dark:bg-stone-800 text-stone-700 dark:text-stone-300 font-extrabold text-xs flex items-center justify-center shrink-0 mt-0.5 group-hover:bg-emerald-600 group-hover:text-white transition">
              <%= idx + 1 %>
            </span>
            <div class="w-14 h-14 rounded-xl overflow-hidden shrink-0 bg-stone-100 dark:bg-stone-800">
              <img src="<%= pop.featured_image %>" alt="<%= pop.title %>" class="w-full h-full object-cover group-hover:scale-105 transition duration-300" loading="lazy" />
            </div>
            <div class="flex-1 min-w-0">
              <span class="text-[10px] uppercase font-bold text-emerald-600 dark:text-emerald-400 tracking-wider">
                <%= pop.pet_type %>
              </span>
              <h4 class="text-xs font-bold text-stone-900 dark:text-white leading-snug line-clamp-2 mt-0.5 group-hover:text-emerald-600 transition">
                <a href="/blog/<%= pop.slug %>"><%= pop.title %></a>
              </h4>
              <div class="flex items-center gap-2 text-[10px] text-stone-400 dark:text-stone-500 mt-1">
                <span><%= pop.reading_time_minutes || 5 %> min read</span>
                <span>•</span>
                <span><%= pop.views || 450 %> reads</span>
              </div>
            </div>
          </article>
        <% }) %>
      <% } else { %>
        <p class="text-xs text-stone-500">Popular guides updating shortly...</p>
      <% } %>
    </div>
  </div>

  <!-- 2. STICKY DISPLAY ADVERTISEMENT SLOT -->
  <div class="sticky top-24 space-y-8">
    <%- include('ad-slot', { type: 'sidebar-sticky' }) %>

    <!-- 3. TOPIC EXPLORER PILLS -->
    <div class="bg-white dark:bg-stone-900 rounded-2xl p-6 border border-stone-200/80 dark:border-stone-800 shadow-sm">
      <h3 class="font-extrabold text-stone-900 dark:text-white text-sm uppercase tracking-wider mb-4 pb-2 border-b border-stone-100 dark:border-stone-800">
        Explore by Species
      </h3>
      <div class="flex flex-wrap gap-2">
        <% categories.forEach(cat => { %>
          <a href="/category/<%= cat.slug %>" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-stone-100 dark:bg-stone-800 hover:bg-emerald-50 dark:hover:bg-emerald-950/40 text-stone-700 dark:text-stone-300 hover:text-emerald-700 dark:hover:text-emerald-400 text-xs font-bold transition">
            <span><%= cat.icon %></span>
            <span><%= cat.name.split('&')[0].trim() %></span>
          </a>
        <% }) %>
      </div>
    </div>

    <!-- 4. PAWPULSE VIP NEWSLETTER (High Lifetime Value Audience) -->
    <div class="bg-gradient-to-br from-stone-900 to-stone-950 text-white rounded-2xl p-6 border border-stone-800 shadow-md">
      <div class="w-10 h-10 rounded-xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center text-xl mb-3">
        📬
      </div>
      <h3 class="font-extrabold text-base text-white m-0">The Weekly Pet Digest</h3>
      <p class="text-xs text-stone-400 mt-1 mb-4 leading-relaxed">
        Join 45,000+ conscious pet parents receiving our clinical behavior breakdowns and food safety alerts every Friday.
      </p>
      <form action="/about#newsletter" method="GET" class="space-y-2">
        <input type="email" placeholder="Enter your email address..." required class="w-full px-3.5 py-2.5 rounded-xl bg-stone-800 border border-stone-700 text-xs text-white placeholder-stone-500 focus:outline-none focus:border-emerald-500" />
        <button type="submit" class="w-full py-2.5 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-stone-950 font-extrabold text-xs transition shadow-sm">
          Subscribe for Free &rarr;
        </button>
      </form>
      <p class="text-[10px] text-stone-500 mt-2 text-center">Zero spam. Unsubscribe anytime with 1 click.</p>
    </div>

    <!-- 5. PET EMERGENCY QUICK REFERENCE -->
    <div class="bg-red-50 dark:bg-red-950/30 border border-red-200 dark:border-red-900/40 rounded-2xl p-5 text-stone-800 dark:text-stone-200">
      <div class="flex items-center gap-2 text-red-700 dark:text-red-400 font-bold text-xs uppercase tracking-wider mb-2">
        <span>🚨</span> 24/7 Pet Emergency Helplines
      </div>
      <p class="text-xs text-stone-600 dark:text-stone-400 mb-3">
        If you suspect your pet has ingested a toxic plant, medication, or food, contact immediately:
      </p>
      <div class="space-y-1.5 text-xs font-semibold">
        <div class="p-2 rounded-lg bg-white dark:bg-stone-900 border border-red-100 dark:border-red-900/20 flex justify-between">
          <span>ASPCA Poison Control:</span>
          <span class="text-red-600 dark:text-red-400 font-bold">(888) 426-4435</span>
        </div>
        <div class="p-2 rounded-lg bg-white dark:bg-stone-900 border border-red-100 dark:border-red-900/20 flex justify-between">
          <span>Pet Poison Helpline:</span>
          <span class="text-red-600 dark:text-red-400 font-bold">(855) 764-7661</span>
        </div>
      </div>
    </div>
  </div>

</aside>
