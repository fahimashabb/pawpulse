<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  
  <title><%= title %></title>
  <meta name="description" content="<%= metaDescription %>">
  <link rel="canonical" href="<%= config.site.url %><%= currentPath %>">
  
  <!-- OpenGraph / Social Meta Tags -->
  <meta property="og:site_name" content="<%= config.site.name %>">
  <meta property="og:title" content="<%= title %>">
  <meta property="og:description" content="<%= metaDescription %>">
  <meta property="og:type" content="<%= typeof pageType !== 'undefined' ? pageType : 'website' %>">
  <meta property="og:url" content="<%= config.site.url %><%= currentPath %>">
  <meta property="og:image" content="<%= typeof article !== 'undefined' ? article.featured_image : 'https://images.unsplash.com/photo-1548199973-03cce0bbc87b?w=1200&auto=format&fit=crop&q=80' %>">

  <!-- Twitter Meta Tags -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= title %>">
  <meta name="twitter:description" content="<%= metaDescription %>">
  <meta name="twitter:image" content="<%= typeof article !== 'undefined' ? article.featured_image : 'https://images.unsplash.com/photo-1548199973-03cce0bbc87b?w=1200&auto=format&fit=crop&q=80' %>">

  <!-- Google AdSense Official Script Integration -->
  <% if (config.monetization.enabled && config.monetization.adsenseClientId && config.monetization.adsenseClientId !== 'ca-pub-XXXXXXXXXXXXX') { %>
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=<%= config.monetization.adsenseClientId %>" crossorigin="anonymous"></script>
  <% } %>

  <!-- Google Fonts: Plus Jakarta Sans & Merriweather for Editorial Reading -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Merriweather:ital,wght@0,300;0,400;0,700;1,300&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
            serif: ['"Merriweather"', 'serif'],
          },
          colors: {
            emerald: {
              50: '#f0fdf4',
              100: '#dcfce7',
              500: '#10b981',
              600: '#059669',
              700: '#047857',
              800: '#065f46',
              900: '#064e3b',
            }
          }
        }
      }
    }
  </script>

  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <!-- Custom CSS for Editorial Polish -->
  <link rel="stylesheet" href="<%= baseUrl %>/css/style.css">

  <% if (typeof articleSchema !== 'undefined' && articleSchema) { %>
    <!-- JSON-LD Article Schema -->
    <script type="application/ld+json">
      <%- articleSchema %>
    </script>
  <% } %>

  <% if (typeof howToSchema !== 'undefined' && howToSchema) { %>
    <!-- JSON-LD HowTo Schema -->
    <script type="application/ld+json">
      <%- howToSchema %>
    </script>
  <% } %>

  <% if (typeof faqSchema !== 'undefined' && faqSchema) { %>
    <!-- JSON-LD FAQPage Schema -->
    <script type="application/ld+json">
      <%- faqSchema %>
    </script>
  <% } %>

  <% if (typeof breadcrumbSchema !== 'undefined' && breadcrumbSchema) { %>
    <!-- JSON-LD Breadcrumb Schema -->
    <script type="application/ld+json">
      <%- breadcrumbSchema %>
    </script>
  <% } %>
</head>
<body class="bg-stone-50 text-stone-800 antialiased font-sans selection:bg-emerald-500 selection:text-white">

  <!-- 1. Top Announcement Bar -->
  <div class="bg-stone-900 text-stone-300 text-xs py-2 px-4 border-b border-stone-800">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      <div class="flex items-center gap-2 overflow-hidden text-ellipsis whitespace-nowrap">
        <span class="bg-emerald-500 text-stone-950 font-extrabold text-[10px] uppercase px-1.5 py-0.5 rounded">Authority</span>
        <span class="truncate">🐾 200+ Veterinary-Reviewed Guides for Dogs, Cats, Birds, Lizards, Snakes & Small Pets</span>
      </div>
      <div class="hidden sm:flex items-center gap-4 text-[11px] shrink-0 font-medium">
        <a href="<%= baseUrl %>/admin/automation" class="text-emerald-400 hover:text-emerald-300 font-bold flex items-center gap-1">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping"></span>
          Automated Pipeline (50/day)
        </a>
        <a href="<%= baseUrl %>/about" class="hover:text-white transition">Editorial Board</a>
        <a href="<%= baseUrl %>/popular" class="hover:text-white transition">Trending</a>
      </div>
    </div>
  </div>

  <!-- 2. Primary Navigation -->
  <header class="bg-white border-b border-stone-200/80 sticky top-0 z-40 shadow-xs">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-20 gap-4">
        
        <!-- Logo -->
        <a href="<%= baseUrl %>/" class="flex items-center gap-2.5 shrink-0 group">
          <div class="w-11 h-11 rounded-2xl bg-gradient-to-tr from-emerald-600 to-teal-500 text-white flex items-center justify-center text-2xl shadow-md group-hover:scale-105 transition transform">
            🐾
          </div>
          <div>
            <span class="text-2xl font-extrabold tracking-tight text-stone-900 group-hover:text-emerald-600 transition flex items-center gap-1">
              <%= config.site.name %>
            </span>
            <span class="block text-[10px] uppercase font-bold tracking-widest text-emerald-700 -mt-1">
              Pet Wisdom & Care Network
            </span>
          </div>
        </a>

        <!-- Search Bar with Live Suggestions -->
        <div class="flex-1 max-w-xl mx-4 hidden md:block">
          <form action="<%= baseUrl %>/search" method="GET" class="relative">
            <input 
              type="text" 
              name="q" 
              placeholder="Search 200+ pet guides (e.g. clip cat nails, dog bloat, bearded dragon UVB)..." 
              value="<%= typeof query !== 'undefined' ? query : '' %>"
              class="w-full pl-11 pr-24 py-2.5 rounded-full bg-stone-100 border border-stone-200 text-sm text-stone-800 placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:bg-white transition"
              required
            />
            <div class="absolute left-4 top-1/2 -translate-y-1/2 text-stone-400">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
            </div>
            <button type="submit" class="absolute right-1.5 top-1/2 -translate-y-1/2 px-4 py-1.5 rounded-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs shadow-xs transition">
              Search
            </button>
          </form>
        </div>

        <!-- Quick Navigation -->
        <nav class="flex items-center gap-3 shrink-0">
          <a href="<%= baseUrl %>/popular" class="hidden sm:inline-flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-bold text-stone-700 hover:bg-stone-100 transition">
            <span class="text-rose-500 font-extrabold">🔥</span>
            <span>Most Popular</span>
          </a>
          <a href="<%= baseUrl %>/admin/automation" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-emerald-50 text-emerald-800 hover:bg-emerald-100 border border-emerald-200 text-xs font-extrabold transition">
            <span>⚙️</span>
            <span>Automation Hub</span>
          </a>
        </nav>

      </div>
    </div>

    <!-- 3. Sub-Header: Species Category Ribbon -->
    <div class="bg-stone-100/80 border-t border-stone-200/80 overflow-x-auto scrollbar-none">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-2.5 flex items-center gap-2 min-w-max">
        <span class="text-[11px] font-bold text-stone-500 uppercase tracking-wider mr-1">Species:</span>
        <% categories.forEach(cat => { %>
          <% const isActive = currentPath === '/category/' + cat.slug; %>
          <a href="<%= baseUrl %>/category/<%= cat.slug %>" 
             class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-bold transition <%= isActive ? 'bg-emerald-600 text-white shadow-xs' : 'bg-white hover:bg-stone-200/60 text-stone-700 border border-stone-200/60' %>">
            <span><%= cat.icon %></span>
            <span><%= cat.name.split('&')[0].trim() %></span>
          </a>
        <% }) %>
      </div>
    </div>
  </header>

  <!-- 4. Global Leaderboard Ad Placement -->
  <div class="max-w-7xl mx-auto px-4 pt-6">
    <%- include('ad-slot', { type: 'header-leaderboard' }) %>
  </div>
