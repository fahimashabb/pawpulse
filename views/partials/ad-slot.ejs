<%# Reusable Ad Slot Component - Fully Optimized for Google AdSense & Core Web Vitals %>
<% 
  const slotType = typeof type !== 'undefined' ? type : 'in-content'; 
  const isDemo = config.monetization.demoMode || !config.monetization.adsenseClientId || config.monetization.adsenseClientId.includes('XXXXX');
  const adClientId = config.monetization.adsenseClientId;
  const slotId = (config.monetization.slots && config.monetization.slots[slotType]) || '1234567890';
%>

<div class="ad-placement-wrapper my-8 mx-auto text-center" data-slot-type="<%= slotType %>">
  <div class="text-[10px] uppercase font-bold tracking-widest text-stone-400 mb-1.5 flex items-center justify-center gap-1 select-none">
    <span>ADVERTISEMENT</span>
    <span class="text-stone-300">•</span>
    <a href="<%= baseUrl %>/about#affiliate" class="hover:underline">Ad Policies</a>
  </div>

  <% if (!isDemo && adClientId) { %>
    <!-- Live Google AdSense Display Unit (Pre-allocated min-height to prevent Layout Shift) -->
    <% if (slotType === 'header-leaderboard') { %>
      <div class="ad-container min-h-[90px] sm:min-h-[100px] flex items-center justify-center bg-stone-100/50 rounded-xl overflow-hidden border border-stone-200/60">
        <ins class="adsbygoogle"
             style="display:block; width:100%;"
             data-ad-client="<%= adClientId %>"
             data-ad-slot="<%= slotId %>"
             data-ad-format="auto"
             data-full-width-responsive="true"></ins>
        <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
      </div>
    <% } else if (slotType === 'sidebar-sticky') { %>
      <div class="ad-container min-h-[280px] sm:min-h-[300px] flex items-center justify-center bg-stone-100/50 rounded-xl overflow-hidden border border-stone-200/60">
        <ins class="adsbygoogle"
             style="display:block; width:100%;"
             data-ad-client="<%= adClientId %>"
             data-ad-slot="<%= slotId %>"
             data-ad-format="auto"
             data-full-width-responsive="true"></ins>
        <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
      </div>
    <% } else { %>
      <!-- In-Article Native Fluid Unit -->
      <div class="ad-container min-h-[140px] sm:min-h-[160px] flex items-center justify-center bg-stone-100/50 rounded-xl overflow-hidden border border-stone-200/60 my-6">
        <ins class="adsbygoogle"
             style="display:block; text-align:center;"
             data-ad-layout="in-article"
             data-ad-format="fluid"
             data-ad-client="<%= adClientId %>"
             data-ad-slot="<%= slotId %>"></ins>
        <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
      </div>
    <% } %>
  <% } else { %>
    <!-- Guaranteed High-Converting Native Pet Sponsor Display (Demo & Review Fallback) -->
    <% if (slotType === 'header-leaderboard') { %>
      <div class="bg-gradient-to-r from-emerald-900 to-teal-800 text-white rounded-2xl p-4 sm:p-5 flex flex-col sm:flex-row items-center justify-between gap-4 shadow-sm max-w-4xl mx-auto border border-emerald-700/50">
        <div class="flex items-center gap-3.5 text-left">
          <div class="w-12 h-12 rounded-xl bg-emerald-500/20 border border-emerald-400/30 flex items-center justify-center text-2xl shrink-0">
            🛡️
          </div>
          <div>
            <div class="flex items-center gap-2 mb-0.5">
              <span class="text-[10px] uppercase bg-emerald-700/80 text-emerald-200 px-2 py-0.5 rounded font-extrabold tracking-wider">Verified Pet Partner</span>
              <span class="text-[10px] text-emerald-300">★ 4.9/5 TrustScore</span>
            </div>
            <h4 class="text-sm sm:text-base font-extrabold m-0 text-white">Compare Top 5 Pet Health Coverage Plans (Up to 90% Vet Bill Reimbursement)</h4>
            <p class="text-xs text-emerald-200/90 m-0">Zero waiting periods for unexpected injury. Calculate your species-specific rates in 30 seconds.</p>
          </div>
        </div>
        <a href="<%= baseUrl %>/about#affiliate" class="shrink-0 bg-amber-400 hover:bg-amber-300 text-stone-950 font-extrabold px-4 py-2.5 rounded-xl text-xs shadow-md transition whitespace-nowrap">
          Compare Verified Plans &rarr;
        </a>
      </div>

    <% } else if (slotType === 'sidebar-sticky') { %>
      <div class="bg-white border-2 border-dashed border-emerald-200 rounded-2xl p-5 text-center shadow-xs">
        <div class="w-full h-32 bg-gradient-to-tr from-emerald-50 to-teal-50 rounded-xl flex items-center justify-center text-4xl mb-3 border border-emerald-100">
          📦🐾
        </div>
        <span class="text-[10px] uppercase font-extrabold tracking-wider text-emerald-800 bg-emerald-100 px-2.5 py-0.5 rounded-full">Veterinary Nutrition Offer</span>
        <h4 class="text-sm font-extrabold text-stone-900 mt-2 mb-1">Save Up to 35% on Your First Clinical Food Delivery</h4>
        <p class="text-xs text-stone-500 mb-3.5 leading-relaxed">Free 1-3 day priority doorstep shipping on board-certified prescription diets and bioactive supplements.</p>
        <a href="<%= baseUrl %>/about#affiliate" class="block w-full py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-xs font-bold transition shadow-xs">
          Claim Verified Partner Discount &rarr;
        </a>
      </div>

    <% } else { %>
      <!-- Standard In-Content Responsive Banner -->
      <div class="bg-stone-50 border border-stone-200/90 rounded-2xl p-4 sm:p-5 flex flex-col sm:flex-row items-center justify-between gap-4 max-w-2xl mx-auto shadow-xs">
        <div class="text-left">
          <div class="flex items-center gap-2 mb-1">
            <span class="text-[10px] uppercase tracking-wider text-emerald-800 font-extrabold bg-emerald-100 px-2 py-0.5 rounded">24/7 Telehealth</span>
            <span class="text-[10px] text-stone-400 font-semibold">Licensed DVMs On Call</span>
          </div>
          <h4 class="text-sm sm:text-base font-extrabold text-stone-900 mt-0.5 mb-1">Consult with a Board-Certified Vet in 5 Minutes</h4>
          <p class="text-xs text-stone-600 m-0 leading-relaxed">Skip the stressful clinic waiting room. Real-time medical advice on canine, feline, and exotic animal symptoms.</p>
        </div>
        <a href="<%= baseUrl %>/about#affiliate" class="shrink-0 bg-stone-900 hover:bg-stone-800 text-white font-bold px-4 py-2.5 rounded-xl text-xs transition shadow-xs">
          Connect with Vet Now &rarr;
        </a>
      </div>
    <% } %>
  <% } %>
</div>
