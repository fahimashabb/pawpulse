<%- include('partials/header') %>

<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

  <!-- Header -->
  <div class="max-w-3xl mx-auto text-center mb-12 space-y-3">
    <span class="px-3 py-1 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-200 text-xs font-bold uppercase tracking-wider">
      Clinical Standards & Ethics
    </span>
    <h1 class="text-3xl sm:text-5xl font-extrabold text-stone-900 tracking-tight">
      Editorial Integrity & Veterinary Review Board
    </h1>
    <p class="text-sm sm:text-base text-stone-600 leading-relaxed">
      How PawPulse produces accurate, evidence-backed, and compassionate pet guidance trusted by hundreds of thousands of animal guardians.
    </p>
  </div>

  <div class="flex flex-col lg:flex-row gap-10">

    <!-- About Content -->
    <div class="flex-1 min-w-0 bg-white rounded-3xl p-6 sm:p-10 border border-stone-200/80 shadow-xs space-y-8">
      
      <!-- Section 1: Our Mission -->
      <section>
        <h2 class="text-2xl font-extrabold text-stone-900 mb-3">Our Mission</h2>
        <p class="text-sm text-stone-600 leading-relaxed mb-4">
          At PawPulse, we believe every companion animal deserves care grounded in biological science, modern veterinary medicine, and low-stress behavioral handling. Whether you care for a domestic cat, an active herding dog, a sensitive cockatiel, an arboreal gecko, or a ball python, our guides provide actionable, clear, and thoroughly vetted advice.
        </p>
      </section>

      <!-- Section 2: Veterinary Review Process (E-E-A-T) -->
      <section id="veterinary-board" class="p-6 rounded-2xl bg-emerald-50/70 border border-emerald-200">
        <h2 class="text-xl font-extrabold text-emerald-950 mb-3 flex items-center gap-2">
          <span>🩺</span> Our Clinical Fact-Checking Standard
        </h2>
        <p class="text-xs sm:text-sm text-emerald-900 leading-relaxed mb-4">
          Every health, nutrition, behavioral, and step-by-step care guide published on PawPulse undergoes a strict three-tier editorial verification process before release:
        </p>
        <ol class="space-y-3 text-xs sm:text-sm text-emerald-900">
          <li class="flex items-start gap-2">
            <span class="font-bold text-emerald-700">1. Literature Grounding:</span>
            <span>Authors must cite peer-reviewed clinical studies (Journal of the American Veterinary Medical Association, Applied Animal Behaviour Science, Journal of Herpetological Medicine).</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="font-bold text-emerald-700">2. Veterinary Review:</span>
            <span>A licensed veterinarian or board-certified behaviorist (DACVB) reviews dosages, temperature parameters, and warning signs for medical accuracy.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="font-bold text-emerald-700">3. Continuous Auditing:</span>
            <span>Guides are reviewed bi-annually to reflect updated pharmacological guidelines, nutrition recalls, and husbandry improvements.</span>
          </li>
        </ol>
      </section>

      <!-- Section 3: Meet Our Editorial Specialists -->
      <section>
        <h2 class="text-2xl font-extrabold text-stone-900 mb-6">Our Contributing Specialists</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          
          <div class="p-4 rounded-2xl border border-stone-200 bg-stone-50 flex items-center gap-3.5">
            <img src="https://images.unsplash.com/photo-1622253692010-333f2da6031d?w=150&auto=format&fit=crop&q=80" alt="Dr. Julian Vance" class="w-14 h-14 rounded-full object-cover border-2 border-emerald-500" />
            <div>
              <h4 class="font-extrabold text-sm text-stone-900 m-0">Dr. Julian Vance, DVM</h4>
              <p class="text-xs text-stone-500 m-0">Veterinary Behavior Specialist</p>
              <span class="text-[10px] text-emerald-700 font-bold">15+ Years Clinical Practice</span>
            </div>
          </div>

          <div class="p-4 rounded-2xl border border-stone-200 bg-stone-50 flex items-center gap-3.5">
            <img src="https://images.unsplash.com/photo-1594824813629-d89771239c4d?w=150&auto=format&fit=crop&q=80" alt="Dr. Elena Rostova" class="w-14 h-14 rounded-full object-cover border-2 border-emerald-500" />
            <div>
              <h4 class="font-extrabold text-sm text-stone-900 m-0">Dr. Elena Rostova, DVM, DACVB</h4>
              <p class="text-xs text-stone-500 m-0">Board-Certified Veterinary Behaviorist</p>
              <span class="text-[10px] text-emerald-700 font-bold">Feline & Canine Ethology</span>
            </div>
          </div>

          <div class="p-4 rounded-2xl border border-stone-200 bg-stone-50 flex items-center gap-3.5">
            <img src="https://images.unsplash.com/photo-1559839734-2b71ea197ec2?w=150&auto=format&fit=crop&q=80" alt="Dr. Siobhan Thorne" class="w-14 h-14 rounded-full object-cover border-2 border-emerald-500" />
            <div>
              <h4 class="font-extrabold text-sm text-stone-900 m-0">Dr. Siobhan Thorne, PhD, DVM</h4>
              <p class="text-xs text-stone-500 m-0">Avian & Exotic Zoological Specialist</p>
              <span class="text-[10px] text-emerald-700 font-bold">Avian Pulmonary Biology</span>
            </div>
          </div>

          <div class="p-4 rounded-2xl border border-stone-200 bg-stone-50 flex items-center gap-3.5">
            <img src="https://images.unsplash.com/photo-1612349317150-e413f6a5b16d?w=150&auto=format&fit=crop&q=80" alt="Dr. Alexander Hayes" class="w-14 h-14 rounded-full object-cover border-2 border-emerald-500" />
            <div>
              <h4 class="font-extrabold text-sm text-stone-900 m-0">Dr. Alexander Hayes, DVM</h4>
              <p class="text-xs text-stone-500 m-0">Herpetological Clinical Researcher</p>
              <span class="text-[10px] text-emerald-700 font-bold">UVB & Reptile Physiology</span>
            </div>
          </div>

        </div>
      </section>

      <!-- Section 4: Advertising & Affiliate Disclosure (AdSense & FTC Mandatory) -->
      <section id="affiliate" class="pt-6 border-t border-stone-200">
        <h2 class="text-2xl font-extrabold text-stone-900 mb-3">Affiliate & Advertising Disclosures</h2>
        <p class="text-xs sm:text-sm text-stone-600 leading-relaxed mb-3">
          <%= config.monetization.affiliateDisclosure %>
        </p>
        <p class="text-xs sm:text-sm text-stone-600 leading-relaxed">
          PawPulse displays advertisements through certified advertising networks (such as Google AdSense and Mediavine). We strictly maintain editorial independence: advertisers have no influence over our clinical ratings, safety warnings, or diagnostic recommendations.
        </p>
      </section>

    </div>

    <!-- Right Sidebar -->
    <%- include('partials/sidebar') %>

  </div>

</main>

<%- include('partials/footer') %>
