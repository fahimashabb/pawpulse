<%- include('partials/header') %>

<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

  <!-- Flash Message Alert -->
  <% if (flash) { %>
    <div class="mb-6 p-4 rounded-2xl bg-emerald-50 border border-emerald-300 text-emerald-900 text-sm font-bold flex items-center justify-between shadow-xs">
      <div class="flex items-center gap-2">
        <span>✅</span>
        <span><%= flash %></span>
      </div>
      <a href="<%= baseUrl %>/admin/automation" class="text-xs text-emerald-700 hover:underline">Dismiss</a>
    </div>
  <% } %>

  <!-- Admin Header -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8 pb-6 border-b border-stone-200">
    <div>
      <div class="flex items-center gap-2 mb-1">
        <span class="w-3 h-3 rounded-full bg-emerald-500 <%= status.isRunning ? 'animate-ping' : '' %>"></span>
        <span class="text-xs font-extrabold uppercase tracking-widest text-emerald-700">Autonomous Content Engine</span>
      </div>
      <h1 class="text-3xl font-extrabold text-stone-900 tracking-tight m-0">
        Automation & Publishing Control Center
      </h1>
      <p class="text-xs text-stone-500 mt-1">
        Autonomous pipeline generating, researching, and publishing 200+ SEO-optimized pet blogs per day.
      </p>
    </div>

    <!-- Quick Actions -->
    <div class="flex items-center gap-3">
      <form action="<%= baseUrl %>/admin/automation/toggle-scheduler" method="POST">
        <button type="submit" class="px-4 py-2.5 rounded-xl font-bold text-xs transition flex items-center gap-2 <%= status.isRunning ? 'bg-amber-100 hover:bg-amber-200 text-amber-900' : 'bg-emerald-600 hover:bg-emerald-700 text-white' %>">
          <span><%= status.isRunning ? '⏸️' : '▶️' %></span>
          <span><%= status.isRunning ? 'Pause 200/Day Automation' : 'Resume 200/Day Automation' %></span>
        </button>
      </form>
    </div>
  </div>

  <!-- Metric Overview Cards -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-8">
    
    <div class="bg-white p-6 rounded-2xl border border-stone-200 shadow-xs">
      <span class="text-xs font-bold text-stone-400 uppercase tracking-wider block mb-1">Total Articles Live</span>
      <div class="text-3xl font-extrabold text-stone-900"><%= status.totalArticlesInDb %></div>
      <span class="text-[11px] text-emerald-600 font-semibold mt-1 block">✓ Search Engine Ready & Indexed</span>
    </div>

    <div class="bg-white p-6 rounded-2xl border border-stone-200 shadow-xs">
      <span class="text-xs font-bold text-stone-400 uppercase tracking-wider block mb-1">Daily Target</span>
      <div class="text-3xl font-extrabold text-stone-900"><%= status.targetPostsPerDay %> <span class="text-sm font-normal text-stone-400">/ day</span></div>
      <span class="text-[11px] text-stone-500 font-semibold mt-1 block">Scheduled every ~<%= status.intervalMinutes %> mins</span>
    </div>

    <div class="bg-white p-6 rounded-2xl border border-stone-200 shadow-xs">
      <span class="text-xs font-bold text-stone-400 uppercase tracking-wider block mb-1">Published This Session</span>
      <div class="text-3xl font-extrabold text-emerald-600"><%= status.publishedToday %></div>
      <span class="text-[11px] text-stone-500 font-semibold mt-1 block">Last: <%= status.lastPublishedTime ? formatDate(status.lastPublishedTime) : 'Ready' %></span>
    </div>

    <div class="bg-white p-6 rounded-2xl border border-stone-200 shadow-xs">
      <span class="text-xs font-bold text-stone-400 uppercase tracking-wider block mb-1">Scheduler Status</span>
      <div class="text-3xl font-extrabold <%= status.isRunning ? 'text-emerald-600' : 'text-amber-600' %>">
        <%= status.isRunning ? 'Active' : 'Paused' %>
      </div>
      <span class="text-[11px] text-stone-500 font-semibold mt-1 block">Continuous Auto-Publishing</span>
    </div>

  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-10">
    
    <!-- Left Column: Manual Triggers & Custom Generation -->
    <div class="lg:col-span-6 space-y-6">

      <!-- 1-Click Batch Trigger -->
      <div class="bg-white p-6 rounded-3xl border border-stone-200 shadow-xs">
        <div class="flex items-center gap-2 mb-2">
          <span class="text-2xl">⚡</span>
          <h3 class="text-lg font-extrabold text-stone-900 m-0">Instant Batch Publisher</h3>
        </div>
        <p class="text-xs text-stone-500 leading-relaxed mb-4">
          Need to publish 200 articles immediately? Click the button below to initiate full research, SEO schema generation, and publication across cats, dogs, reptiles, birds, snakes, and small pets.
        </p>

        <form action="<%= baseUrl %>/admin/automation/publish-batch" method="POST" onsubmit="this.querySelector('button').disabled=true; this.querySelector('button').innerText='Generating 200 Articles... Please wait ~15s';">
          <input type="hidden" name="count" value="200" />
          <button type="submit" class="w-full py-3.5 px-4 bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold text-sm rounded-xl transition shadow-md flex items-center justify-center gap-2">
            <span>🚀 Publish Batch of 200 Articles Now</span>
          </button>
        </form>
      </div>

      <!-- Custom Topic Publisher (Powered by Gemini AI + Clinical Matrix) -->
      <div class="bg-white p-6 rounded-3xl border border-stone-200 shadow-xs">
        <div class="flex items-center justify-between mb-2">
          <div class="flex items-center gap-2">
            <span class="text-2xl">✨</span>
            <h3 class="text-lg font-extrabold text-stone-900 m-0">AI Custom Topic Research</h3>
          </div>
          <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-800 text-[10px] font-extrabold uppercase">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-600 animate-pulse"></span>
            Gemini 3.5 Flash Active
          </span>
        </div>
        <p class="text-xs text-stone-500 leading-relaxed mb-4">
          Type any specific pet question or medical symptom. Google Gemini AI will conduct deep veterinary ethology research, generate step-by-step clinical protocols, format FAQs, and publish it live.
        </p>

        <form action="<%= baseUrl %>/admin/automation/publish-custom" method="POST" class="space-y-3" onsubmit="this.querySelector('button').disabled=true; this.querySelector('button').innerText='Synthesizing with Gemini AI... Please wait ~4s';">
          <input 
            type="text" 
            name="prompt" 
            placeholder="e.g. Feline Hyperesthesia Syndrome: Neurological Baselines & Low-Stress Protocols" 
            required 
            class="w-full px-4 py-3 rounded-xl bg-stone-50 border border-stone-200 text-xs text-stone-800 placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-emerald-500"
          />

          <div class="grid grid-cols-2 gap-2">
            <div>
              <label class="block text-[10px] font-bold uppercase text-stone-500 mb-1">Target Species</label>
              <select name="species" class="w-full px-3 py-2 rounded-xl bg-stone-50 border border-stone-200 text-xs text-stone-700 focus:outline-none focus:ring-2 focus:ring-emerald-500">
                <option value="">Auto-Detect from Prompt</option>
                <option value="Cat">Cats (Feline)</option>
                <option value="Dog">Dogs (Canine)</option>
                <option value="Parrot">Birds (Avian)</option>
                <option value="Bearded Dragon">Lizards & Reptiles</option>
                <option value="Ball Python">Snakes & Serpents</option>
                <option value="Rabbit">Small Mammals / Rabbits</option>
                <option value="Betta Fish">Aquatics & Fish</option>
              </select>
            </div>
            <div class="flex items-end">
              <label class="flex items-center gap-2 p-2 rounded-xl bg-emerald-50/60 border border-emerald-200/80 w-full cursor-pointer">
                <input type="checkbox" name="useGemini" value="1" checked class="rounded text-emerald-600 focus:ring-emerald-500 h-4 w-4" />
                <span class="text-xs font-bold text-emerald-900">Use Gemini AI</span>
              </label>
            </div>
          </div>

          <button type="submit" class="w-full py-3 px-4 bg-stone-900 hover:bg-stone-800 text-white font-bold text-xs rounded-xl transition shadow-sm">
            Generate & Publish with Gemini AI &rarr;
          </button>
        </form>
      </div>

    </div>

    <!-- Right Column: Species Inventory Breakdown -->
    <div class="lg:col-span-6 bg-white p-6 rounded-3xl border border-stone-200 shadow-xs">
      <h3 class="text-lg font-extrabold text-stone-900 mb-4">Article Inventory by Species Hub</h3>
      <div class="space-y-3">
        <% categoryCounts.forEach(cc => { %>
          <div class="flex items-center justify-between p-3 rounded-xl bg-stone-50 border border-stone-100">
            <div class="flex items-center gap-2">
              <span class="text-base font-bold text-stone-900"><%= cc.name %></span>
            </div>
            <div class="flex items-center gap-3">
              <span class="text-xs font-extrabold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-full border border-emerald-200">
                <%= cc.count %> Articles
              </span>
              <a href="<%= baseUrl %>/category/<%= cc.slug %>" class="text-xs font-bold text-stone-400 hover:text-emerald-600 transition">View &rarr;</a>
            </div>
          </div>
        <% }) %>
      </div>
    </div>

  </div>

  <!-- Affiliate Monetization & Commercial Partner Command Center -->
  <div class="bg-white p-6 sm:p-8 rounded-3xl border border-stone-200 shadow-xs mb-10">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-6 pb-4 border-b border-stone-200">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <span class="text-xl">💰</span>
          <span class="text-xs font-extrabold uppercase tracking-wider text-emerald-700">Commercial Operations</span>
        </div>
        <h3 class="text-xl font-extrabold text-stone-900 m-0">
          Affiliate Program Registry & Tracking ID Hub
        </h3>
        <p class="text-xs text-stone-500 mt-1">
          Outgoing product recommendations and review CTA links in all 600+ articles automatically wrap with these tags.
        </p>
      </div>
      <div class="flex items-center gap-2">
        <a href="<%= baseUrl %>/affiliates" target="_blank" class="px-3.5 py-2 rounded-xl bg-stone-100 hover:bg-stone-200 text-stone-800 text-xs font-bold transition flex items-center gap-1.5">
          <span>🛡️</span>
          <span>Public Transparency Hub &rarr;</span>
        </a>
      </div>
    </div>

    <form action="<%= baseUrl %>/admin/automation/save-affiliates" method="POST" class="space-y-6">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

        <!-- Amazon Associates -->
        <div class="p-4 rounded-2xl bg-stone-50 border border-stone-200/80 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-2">
              <strong class="text-xs font-bold text-amber-700 uppercase tracking-wider">Amazon Associates</strong>
              <a href="https://affiliate-program.amazon.com/" target="_blank" rel="noopener" class="text-[10px] text-emerald-700 font-bold hover:underline">Apply Portal &rarr;</a>
            </div>
            <label class="block text-[11px] font-semibold text-stone-600 mb-1">Tracking Tag (Associate ID)</label>
            <input 
              type="text" 
              name="amazonTag" 
              value="<%= config.monetization.affiliateTag || 'pawpulse-20' %>" 
              placeholder="e.g. pawpulse-20" 
              class="w-full px-3 py-2 rounded-xl bg-white border border-stone-300 text-xs text-stone-900 font-mono focus:ring-2 focus:ring-emerald-500" 
            />
            <span class="text-[10px] text-stone-400 mt-1 block">1% – 3% commission &bull; 24h cookie</span>
          </div>
          <div class="mt-3 pt-2 border-t border-stone-200/60 flex items-center justify-between text-[11px]">
            <span class="text-emerald-700 font-bold">✓ Active in Articles</span>
            <a href="https://www.amazon.com/s?k=pet+care&tag=<%= config.monetization.affiliateTag %>" target="_blank" rel="noopener" class="text-stone-500 hover:text-stone-900 text-[10px] underline">Test Link</a>
          </div>
        </div>

        <!-- Chewy (Partnerize) -->
        <div class="p-4 rounded-2xl bg-stone-50 border border-stone-200/80 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-2">
              <strong class="text-xs font-bold text-blue-700 uppercase tracking-wider">Chewy Affiliate</strong>
              <a href="https://chewy.partnerize.com/" target="_blank" rel="noopener" class="text-[10px] text-blue-700 font-bold hover:underline">Apply on Partnerize &rarr;</a>
            </div>
            <label class="block text-[11px] font-semibold text-stone-600 mb-1">Partnerize Campaign/User ID</label>
            <input 
              type="text" 
              name="chewyPartnerId" 
              value="<%= (config.monetization.affiliates && config.monetization.affiliates.chewy && config.monetization.affiliates.chewy.partnerId) || 'pawpulse' %>" 
              placeholder="e.g. pawpulse" 
              class="w-full px-3 py-2 rounded-xl bg-white border border-stone-300 text-xs text-stone-900 font-mono focus:ring-2 focus:ring-emerald-500" 
            />
            <span class="text-[10px] text-stone-400 mt-1 block">$15 – $20 new customer bounty &bull; 15d cookie</span>
          </div>
          <div class="mt-3 pt-2 border-t border-stone-200/60 flex items-center justify-between text-[11px]">
            <span class="text-blue-700 font-bold">Prescription Diets</span>
            <a href="https://www.chewy.com/app/content/affiliate" target="_blank" rel="noopener" class="text-stone-500 hover:text-stone-900 text-[10px] underline">Guidelines</a>
          </div>
        </div>

        <!-- Lemonade Pet Insurance -->
        <div class="p-4 rounded-2xl bg-stone-50 border border-stone-200/80 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-2">
              <strong class="text-xs font-bold text-pink-700 uppercase tracking-wider">Lemonade Insurance</strong>
              <a href="https://app.impact.com/campaign-promo-signup/Lemonade.brand" target="_blank" rel="noopener" class="text-[10px] text-pink-700 font-bold hover:underline">Apply on Impact &rarr;</a>
            </div>
            <label class="block text-[11px] font-semibold text-stone-600 mb-1">Impact.com Partner ID / Campaign</label>
            <input 
              type="text" 
              name="lemonadePartnerId" 
              value="<%= (config.monetization.affiliates && config.monetization.affiliates.lemonade && config.monetization.affiliates.lemonade.partnerId) || 'pawpulse_pet' %>" 
              placeholder="e.g. pawpulse_pet" 
              class="w-full px-3 py-2 rounded-xl bg-white border border-stone-300 text-xs text-stone-900 font-mono focus:ring-2 focus:ring-emerald-500" 
            />
            <span class="text-[10px] text-stone-400 mt-1 block">$25 – $40 per completed quote lead</span>
          </div>
          <div class="mt-3 pt-2 border-t border-stone-200/60 flex items-center justify-between text-[11px]">
            <span class="text-pink-700 font-bold">High Payout EPC</span>
            <a href="https://www.lemonade.com/pet" target="_blank" rel="noopener" class="text-stone-500 hover:text-stone-900 text-[10px] underline">Preview Landing</a>
          </div>
        </div>

        <!-- Embark Dog DNA -->
        <div class="p-4 rounded-2xl bg-stone-50 border border-stone-200/80 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-2">
              <strong class="text-xs font-bold text-purple-700 uppercase tracking-wider">Embark Vet DNA</strong>
              <a href="https://embarkvet.com/affiliates/" target="_blank" rel="noopener" class="text-[10px] text-purple-700 font-bold hover:underline">Apply on Impact &rarr;</a>
            </div>
            <label class="block text-[11px] font-semibold text-stone-600 mb-1">Impact Partner Tracking Tag</label>
            <input 
              type="text" 
              name="embarkPartnerId" 
              value="<%= (config.monetization.affiliates && config.monetization.affiliates.embark && config.monetization.affiliates.embark.partnerId) || 'pawpulse' %>" 
              placeholder="e.g. pawpulse" 
              class="w-full px-3 py-2 rounded-xl bg-white border border-stone-300 text-xs text-stone-900 font-mono focus:ring-2 focus:ring-emerald-500" 
            />
            <span class="text-[10px] text-stone-400 mt-1 block">10% commission ($15 – $25/sale)</span>
          </div>
          <div class="mt-3 pt-2 border-t border-stone-200/60 flex items-center justify-between text-[11px]">
            <span class="text-purple-700 font-bold">Cornell Vet Partner</span>
            <a href="https://embarkvet.com/" target="_blank" rel="noopener" class="text-stone-500 hover:text-stone-900 text-[10px] underline">Kits</a>
          </div>
        </div>

        <!-- Petco (CJ Affiliate) -->
        <div class="p-4 rounded-2xl bg-stone-50 border border-stone-200/80 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-2">
              <strong class="text-xs font-bold text-cyan-800 uppercase tracking-wider">Petco (CJ Affiliate)</strong>
              <a href="https://www.petco.com/shop/en/petcostore/c/affiliate-program" target="_blank" rel="noopener" class="text-[10px] text-cyan-800 font-bold hover:underline">Apply on CJ &rarr;</a>
            </div>
            <label class="block text-[11px] font-semibold text-stone-600 mb-1">CJ Affiliate Publisher ID</label>
            <input 
              type="text" 
              name="petcoPartnerId" 
              value="<%= (config.monetization.affiliates && config.monetization.affiliates.petco && config.monetization.affiliates.petco.partnerId) || 'pawpulse' %>" 
              placeholder="e.g. pawpulse" 
              class="w-full px-3 py-2 rounded-xl bg-white border border-stone-300 text-xs text-stone-900 font-mono focus:ring-2 focus:ring-emerald-500" 
            />
            <span class="text-[10px] text-stone-400 mt-1 block">2% – 4% commission &bull; Aquatics & Reptiles</span>
          </div>
          <div class="mt-3 pt-2 border-t border-stone-200/60 flex items-center justify-between text-[11px]">
            <span class="text-cyan-800 font-bold">Omnichannel Store</span>
            <a href="https://www.petco.com/" target="_blank" rel="noopener" class="text-stone-500 hover:text-stone-900 text-[10px] underline">Shop</a>
          </div>
        </div>

        <!-- JustAnswer 24/7 Vet Telehealth -->
        <div class="p-4 rounded-2xl bg-stone-50 border border-stone-200/80 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-2">
              <strong class="text-xs font-bold text-emerald-800 uppercase tracking-wider">JustAnswer Vet Triage</strong>
              <a href="https://www.justanswer.com/affiliates" target="_blank" rel="noopener" class="text-[10px] text-emerald-800 font-bold hover:underline">Apply Portal &rarr;</a>
            </div>
            <label class="block text-[11px] font-semibold text-stone-600 mb-1">Referral Partner Handle</label>
            <input 
              type="text" 
              name="justanswerPartnerId" 
              value="<%= (config.monetization.affiliates && config.monetization.affiliates.justanswer && config.monetization.affiliates.justanswer.partnerId) || 'pawpulse' %>" 
              placeholder="e.g. pawpulse" 
              class="w-full px-3 py-2 rounded-xl bg-white border border-stone-300 text-xs text-stone-900 font-mono focus:ring-2 focus:ring-emerald-500" 
            />
            <span class="text-[10px] text-stone-400 mt-1 block">$5 – $15 per veterinary consult lead</span>
          </div>
          <div class="mt-3 pt-2 border-t border-stone-200/60 flex items-center justify-between text-[11px]">
            <span class="text-emerald-800 font-bold">24/7 Live Triage</span>
            <a href="https://www.justanswer.com/sip/veterinary" target="_blank" rel="noopener" class="text-stone-500 hover:text-stone-900 text-[10px] underline">Preview</a>
          </div>
        </div>

      </div>

      <!-- Google AdSense & Monetization Mode -->
      <div class="p-5 rounded-2xl bg-stone-100/70 border border-stone-200">
        <h4 class="text-xs font-bold uppercase tracking-wider text-stone-800 mb-3 flex items-center gap-2">
          <span>🎯</span> Google AdSense Settings
        </h4>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 items-center">
          <div>
            <label class="block text-[11px] font-semibold text-stone-600 mb-1">AdSense Publisher ID (ca-pub-XXXXXXXXXXXXX)</label>
            <input 
              type="text" 
              name="adsenseClientId" 
              value="<%= config.monetization.adsenseClientId %>" 
              placeholder="ca-pub-XXXXXXXXXXXXXXXX" 
              class="w-full px-3 py-2 rounded-xl bg-white border border-stone-300 text-xs font-mono text-stone-900 focus:ring-2 focus:ring-emerald-500" 
            />
          </div>
          <div class="pt-4 sm:pt-0">
            <label class="flex items-center gap-3 cursor-pointer">
              <input 
                type="checkbox" 
                name="demoMode" 
                value="1" 
                <%= config.monetization.demoMode ? 'checked' : '' %> 
                class="rounded text-emerald-600 focus:ring-emerald-500 h-4 w-4" 
              />
              <span class="text-xs font-semibold text-stone-800">
                Ad Demo Mode (Visual Placeholders for AdSense Review Audit)
              </span>
            </label>
            <span class="text-[10px] text-stone-400 block mt-1">
              Uncheck once Google AdSense approves your domain to serve real live ad inventory.
            </span>
          </div>
        </div>
      </div>

      <div class="flex items-center justify-end">
        <button type="submit" class="py-3 px-6 bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold text-xs rounded-xl transition shadow-md flex items-center gap-2">
          <span>💾 Save Affiliate & Ad Monetization Settings</span>
        </button>
      </div>
    </form>
  </div>

  <!-- Publishing Activity Logs -->
  <div class="bg-white p-6 rounded-3xl border border-stone-200 shadow-xs">
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-lg font-extrabold text-stone-900 m-0">Publishing Activity & Audit Logs</h3>
      <span class="text-xs text-stone-400">Real-time system telemetry</span>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs">
        <thead>
          <tr class="border-b border-stone-200 text-stone-400 uppercase tracking-wider font-bold">
            <th class="py-3 px-4">Timestamp</th>
            <th class="py-3 px-4">Count</th>
            <th class="py-3 px-4">Status</th>
            <th class="py-3 px-4">Log Details</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-stone-100">
          <% if (logs && logs.length > 0) { %>
            <% logs.forEach(log => { %>
              <tr class="hover:bg-stone-50 transition">
                <td class="py-3 px-4 text-stone-500 whitespace-nowrap"><%= formatDate(log.timestamp) %></td>
                <td class="py-3 px-4 font-bold text-stone-900">+<%= log.articles_count %></td>
                <td class="py-3 px-4">
                  <span class="px-2 py-0.5 rounded text-[10px] font-extrabold uppercase <%= log.status === 'SUCCESS' ? 'bg-emerald-100 text-emerald-800' : 'bg-red-100 text-red-800' %>">
                    <%= log.status %>
                  </span>
                </td>
                <td class="py-3 px-4 text-stone-600"><%= log.details %></td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="4" class="py-6 text-center text-stone-400">No logs recorded yet.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

</main>

<%- include('partials/footer') %>
