<%- include('partials/header') %>

<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

  <!-- 1. HERO FEATURED SHOWCASE -->
  <% if (heroMain) { %>
    <section class="mb-14">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        
        <!-- Large Primary Hero -->
        <article class="lg:col-span-7 relative group rounded-3xl overflow-hidden bg-stone-900 shadow-md flex flex-col justify-end min-h-[440px] p-6 sm:p-10">
          <img src="<%= heroMain.featured_image %>" alt="<%= heroMain.title %>" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition duration-700 opacity-60" />
          <div class="absolute inset-0 bg-gradient-to-t from-stone-950 via-stone-950/60 to-transparent"></div>
          
          <div class="relative z-10 space-y-3">
            <div class="flex items-center gap-2">
              <span class="px-3 py-1 rounded-full bg-emerald-500 text-stone-950 font-extrabold text-[11px] uppercase tracking-wider">
                Featured Cover Story
              </span>
              <span class="text-xs text-stone-300 font-semibold">•</span>
              <span class="text-xs text-emerald-300 font-bold uppercase tracking-wider"><%= heroMain.pet_type %></span>
            </div>

            <h1 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight leading-tight group-hover:text-emerald-300 transition">
              <a href="<%= baseUrl %>/blog/<%= heroMain.slug %>"><%= heroMain.title %></a>
            </h1>

            <p class="text-sm text-stone-300 line-clamp-2 leading-relaxed">
              <%= heroMain.excerpt %>
            </p>

            <div class="flex items-center gap-3 pt-2 text-xs text-stone-400">
              <img src="<%= heroMain.author_avatar %>" alt="<%= heroMain.author_name %>" class="w-7 h-7 rounded-full object-cover border border-white/20" />
              <span class="text-stone-200 font-medium"><%= heroMain.author_name %></span>
              <span>•</span>
              <span><%= heroMain.reading_time_minutes %> min read</span>
              <span>•</span>
              <span><%= heroMain.views %> reads</span>
            </div>
          </div>
        </article>

        <!-- Secondary Hero Grid (4 articles) -->
        <div class="lg:col-span-5 grid grid-cols-1 sm:grid-cols-2 gap-4">
          <% heroSub.forEach(sub => { %>
            <article class="relative group rounded-2xl overflow-hidden bg-stone-900 shadow-sm flex flex-col justify-end min-h-[210px] p-4">
              <img src="<%= sub.featured_image %>" alt="<%= sub.title %>" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition duration-500 opacity-50" />
              <div class="absolute inset-0 bg-gradient-to-t from-stone-950 via-stone-950/70 to-transparent"></div>
              
              <div class="relative z-10 space-y-1.5">
                <span class="text-[10px] uppercase font-bold text-emerald-400 tracking-wider">
                  <%= sub.pet_type %>
                </span>
                <h3 class="text-sm font-bold text-white line-clamp-2 leading-snug group-hover:text-emerald-300 transition">
                  <a href="<%= baseUrl %>/blog/<%= sub.slug %>"><%= sub.title %></a>
                </h3>
                <div class="flex items-center gap-2 text-[10px] text-stone-400">
                  <span><%= formatDate(sub.published_at) %></span>
                  <span>•</span>
                  <span><%= sub.reading_time_minutes %> min</span>
                </div>
              </div>
            </article>
          <% }) %>
        </div>

      </div>
    </section>
  <% } %>

  <!-- 2. SPECIES CATEGORY CARDS EXPLORER -->
  <section class="mb-14">
    <div class="flex items-center justify-between mb-6">
      <div>
        <h2 class="text-xl font-extrabold text-stone-900 tracking-tight m-0">Browse by Companion Species</h2>
        <p class="text-xs text-stone-500 mt-1">Deep veterinary protocols categorized for your exact pet</p>
      </div>
      <span class="text-xs font-bold text-emerald-700 bg-emerald-50 px-3 py-1 rounded-full border border-emerald-200">
        <%= totalArticles %> Guides Published
      </span>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-7 gap-3">
      <% categories.forEach(cat => { %>
        <a href="<%= baseUrl %>/category/<%= cat.slug %>" class="p-4 rounded-2xl bg-white border border-stone-200/80 hover:border-emerald-500 hover:shadow-md transition text-center group flex flex-col items-center">
          <span class="text-3xl mb-2 group-hover:scale-110 transition transform"><%= cat.icon %></span>
          <span class="text-xs font-bold text-stone-900 group-hover:text-emerald-700 transition block truncate max-w-full">
            <%= cat.name.split('&')[0].trim() %>
          </span>
          <span class="text-[10px] text-stone-400 mt-1 font-medium">Explore Hub &rarr;</span>
        </a>
      <% }) %>
    </div>
  </section>

  <!-- 3. MAIN CONTENT: RECENT ARTICLES + PERSISTENT POPULAR SIDEBAR -->
  <div class="flex flex-col lg:flex-row gap-10">
    
    <!-- Left Column: Recent Guides Stream -->
    <div class="flex-1 min-w-0">
      <div class="flex items-center justify-between pb-4 mb-6 border-b border-stone-200">
        <div>
          <h2 class="text-2xl font-extrabold text-stone-900 tracking-tight m-0">Latest Veterinary Guides & Stories</h2>
          <p class="text-xs text-stone-500 mt-1">Clinical research, species ethology, and step-by-step care manuals</p>
        </div>
        <a href="<%= baseUrl %>/popular" class="text-xs font-bold text-emerald-600 hover:underline">View Trending &rarr;</a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <% recentArticles.forEach(art => { %>
          <article class="bg-white rounded-2xl border border-stone-200/80 overflow-hidden shadow-xs hover:shadow-md transition duration-300 flex flex-col group">
            <div class="relative h-48 overflow-hidden bg-stone-100">
              <img src="<%= art.featured_image %>" alt="<%= art.title %>" class="w-full h-full object-cover group-hover:scale-105 transition duration-500" loading="lazy" />
              <div class="absolute top-3 left-3 flex gap-1.5">
                <span class="px-2.5 py-1 rounded-lg bg-stone-900/80 backdrop-blur-xs text-white text-[10px] font-extrabold uppercase tracking-wider">
                  <%= art.pet_type %>
                </span>
                <% if (art.schema_type === 'HowTo') { %>
                  <span class="px-2.5 py-1 rounded-lg bg-emerald-600 text-white text-[10px] font-extrabold uppercase tracking-wider">
                    How-To Guide
                  </span>
                <% } %>
              </div>
            </div>

            <div class="p-5 flex-1 flex flex-col justify-between">
              <div>
                <h3 class="text-base font-extrabold text-stone-900 leading-snug group-hover:text-emerald-600 transition mb-2">
                  <a href="<%= baseUrl %>/blog/<%= art.slug %>"><%= art.title %></a>
                </h3>
                <p class="text-xs text-stone-600 line-clamp-3 leading-relaxed mb-4">
                  <%= art.excerpt %>
                </p>
              </div>

              <div class="pt-4 border-t border-stone-100 flex items-center justify-between text-xs text-stone-400">
                <div class="flex items-center gap-2">
                  <img src="<%= art.author_avatar %>" alt="<%= art.author_name %>" class="w-6 h-6 rounded-full object-cover" />
                  <span class="text-stone-700 font-medium truncate max-w-[120px]"><%= art.author_name %></span>
                </div>
                <span><%= art.reading_time_minutes %> min read</span>
              </div>
            </div>
          </article>
        <% }) %>
      </div>

      <!-- Mid-Stream In-Content Ad Placement -->
      <div class="my-10">
        <%- include('partials/ad-slot', { type: 'inContentMid' }) %>
      </div>

      <!-- Explore More Banner -->
      <div class="bg-gradient-to-r from-emerald-800 to-teal-900 rounded-2xl p-8 text-white text-center shadow-sm">
        <span class="text-xs uppercase font-extrabold tracking-widest text-emerald-300">Over 200+ Guides Available</span>
        <h3 class="text-2xl font-extrabold mt-2 mb-3">Looking for a Specific Pet Care Topic?</h3>
        <p class="text-xs text-emerald-100/90 max-w-lg mx-auto mb-6 leading-relaxed">
          From trimming cat claws pain-free to diagnosing reptile brumation, search our comprehensive database of veterinary articles.
        </p>
        <div class="flex justify-center gap-3 flex-wrap">
          <a href="<%= baseUrl %>/search?q=cat" class="px-4 py-2 bg-white text-stone-900 font-bold rounded-xl text-xs hover:bg-emerald-50 transition">Cat Guides 🐱</a>
          <a href="<%= baseUrl %>/search?q=dog" class="px-4 py-2 bg-white text-stone-900 font-bold rounded-xl text-xs hover:bg-emerald-50 transition">Dog Guides 🐶</a>
          <a href="<%= baseUrl %>/search?q=reptile" class="px-4 py-2 bg-white text-stone-900 font-bold rounded-xl text-xs hover:bg-emerald-50 transition">Reptile Care 🦎</a>
          <a href="<%= baseUrl %>/search?q=bird" class="px-4 py-2 bg-white text-stone-900 font-bold rounded-xl text-xs hover:bg-emerald-50 transition">Bird Insights 🦜</a>
        </div>
      </div>

    </div>

    <!-- Right Column: Sidebar (Popular Articles, Sticky Ad, Newsletter) -->
    <%- include('partials/sidebar') %>

  </div>

</main>

<%- include('partials/footer') %>
